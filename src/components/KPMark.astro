---
// The KP mark, traced from the client's own pen sketch (2026-08-19) and
// cleaned up: her drawn ring, the K standing in a framed panel, the P looped
// over it, sparkles off the right shoulder.
//
// The rule that ran under the bowl of the P and out to the right is gone at
// the client's ask (2026-09-03, "umazat carku pod P"). It is in her sketch, so
// do not put it back as a tracing correction - its absence is the decision.
//
// Everything is currentColor, so one component serves the brick mark on the
// white bar and the white one on the dark bands.
//
// `letters` no longer means "the same drawing without its ring". Since
// 2026-09-11 it is a different mark: K and P set in the site's own Cutive
// Mono, because the client looked at her painted K traced into curves and
// asked for the hand taken out of it. The two branches are therefore two
// marks, not two crops of one, and only this one ships - both the masthead
// and the footer pass `letters`.
//
// Her drawing is kept below, untouched, because whether it survives anywhere
// on the site is still open and the footer is the obvious home for it. Nothing
// renders it today. Deleting it is a decision of hers, not a cleanup.
interface Props {
  letters?: boolean;
}
const { letters = false } = Astro.props;
---
{letters ? (
<svg viewBox="32.13 70.53 109.87 75.47" aria-hidden="true">
  <g class="kp-letters">
    <!-- K and P set in Cutive Mono, the face every heading on the site already
         uses, and converted to outlines so the mark does not depend on the
         font having loaded. Nothing here is drawn by hand: the client asked
         for exactly this on 2026-09-11 after seeing her own painted K traced
         back into curves - "ja jsem to malovala rucne a nelibi se mi ze to je
         krive... proste aby to byly dve pismena naseho fontu vedle sebe".
         The letters are the font's, untouched; the only decision in the mark
         is how far they sit into one another. -->
    <path fill="currentColor" d="M35.41 146.00 L33.80 146.00 L32.13 144.26 L32.13 143.23 L32.13 142.20 L33.74 140.46 L35.35 140.46 L45.60 140.46 L45.60 76.13 L35.35 76.13 L33.74 76.13 L32.13 74.39 L32.13 73.36 L32.13 72.27 L33.80 70.53 L35.41 70.53 L64.10 70.53 L65.71 70.53 L67.32 72.33 L67.32 73.43 L67.32 74.46 L65.84 76.13 L64.22 76.13 L51.79 76.13 L51.79 110.04 L88.91 76.52 L89.36 76.07 L89.36 75.88 L89.36 75.49 L88.14 75.49 L82.40 75.49 L80.79 75.49 L79.24 74.01 L79.24 73.10 L79.24 72.14 L80.92 70.53 L82.46 70.53 L105.80 70.53 L107.41 70.53 L108.96 72.27 L108.96 73.36 L108.96 74.39 L107.41 76.13 L105.86 76.13 L96.97 76.13 L68.74 102.43 L102.32 140.46 L111.15 140.46 L112.69 140.46 L114.24 142.20 L114.24 143.23 L114.24 144.26 L112.69 146.00 L111.08 146.00 L84.14 146.00 L82.53 146.00 L80.92 144.26 L80.92 143.23 L80.92 142.20 L82.46 140.46 L84.08 140.46 L94.78 140.46 L63.97 105.97 L52.04 116.03 L52.04 140.46 L67.77 140.46 L69.38 140.46 L70.93 142.20 L70.93 143.23 L70.93 144.26 L69.32 146.00 L67.71 146.00 Z"/>

    <!-- The P pulled left into the K. 73.16 is 46% of one Cutive Mono advance
         (79.92 units at the font-size these outlines were taken at), which is
         the number she read off the slider on 2026-09-11 and sent back as
         "vybrano zasunuti 46%". A translate rather than a rewritten path, so
         the one open decision in the mark stays one number.
         Do not go past 52%: below that the K's lower slab, which the font runs
         56 units longer than its upper one, stops about a unit short of the
         P's slab, and that notch is too small to read as a gap and too big to
         read as a join. -->
    <g transform="translate(73.16 0)">
      <path fill="currentColor" d="M11.21 146.00 L9.60 146.00 L7.93 144.26 L7.93 143.23 L7.93 142.20 L9.54 140.46 L11.15 140.46 L22.30 140.46 L22.30 76.07 L12.05 76.07 L10.44 76.07 L8.89 74.39 L8.89 73.36 L8.89 72.27 L10.51 70.53 L12.12 70.53 L34.29 70.53 L40.80 70.53 L53.17 71.56 L63.04 75.49 L68.84 84.00 L68.84 91.41 L68.84 98.82 L63.29 107.20 L53.95 111.07 L42.15 112.03 L35.96 112.03 L28.49 112.03 L28.49 140.46 L49.69 140.46 L51.30 140.46 L52.85 142.20 L52.85 143.23 L52.85 144.26 L51.24 146.00 L49.63 146.00 Z M28.49 106.88 L38.29 106.88 L42.99 106.88 L51.69 106.17 L58.59 103.33 L62.65 97.14 L62.65 91.67 L62.65 85.80 L57.75 79.42 L49.69 76.65 L40.15 76.07 L35.58 76.07 L28.49 76.07 Z"/>
    </g>
  </g>
</svg>
) : (
<svg viewBox="0 0 200 200" aria-hidden="true">

  <!-- Traced from the client's pen sketch (2026-08-19). Her structure kept:
       drawn ring, K standing in a framed panel, P looped over the top of it,
       sparkles off the right shoulder. All currentColor, so one file serves
       the white bar, the dark ground and the footer. -->

  <!-- everything that is frame rather than letter -->
  <g class="kp-frame" fill="none" stroke="currentColor" stroke-linejoin="round">
    <path d="M98 7 C150 4 195 46 193 101 C191 154 150 196 99 193 C47 190 8 151 7 99 C6 47 46 10 98 7 Z" stroke-width="5"/>
    <path d="M186 86 C191 130 157 179 107 184 C75 187 45 172 29 146" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M31 43 H128 V163 H31 Z" stroke-width="3.5"/>
    <path d="M38 43 V163" stroke-width="2"/>
    <path d="M43 51 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5" stroke-width="2.2"/>
    <path d="M43 155 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5 l6 -5 l6 5" stroke-width="2.2"/>
    <path d="M22 92 c-7 0 -9 10 -2 11 c6 1 8 -8 1 -10" stroke-width="2"/>
    <path d="M22 108 c-7 0 -9 10 -2 11 c6 1 8 -8 1 -10" stroke-width="2"/>
  </g>
  <g class="kp-frame" fill="currentColor">
    <circle cx="46" cy="146" r="3.4"/>
    <circle cx="57" cy="152" r="2.8"/>
    <circle cx="47" cy="157" r="2.2"/>
  </g>

  <!-- K: slab stem, slab foot, two arms reaching under the P -->
  <g class="kp-letters">
    <g fill="currentColor">
      <path d="M33 52 H70 V61 H33 Z"/>
      <path d="M45 52 H58 V142 H45 Z"/>
      <path d="M31 133 H72 V142 H31 Z"/>
    </g>
    <g fill="none" stroke="currentColor" stroke-linecap="butt">
      <path d="M57 99 L97 56" stroke-width="11"/>
      <path d="M57 101 L100 142" stroke-width="12"/>
    </g>

    <!-- P laid over the K, pulled ten units left so the two letters interlock
         rather than merely touch (client, 2026-09-03: "zkus jeste P posunout
         trochu do K, prolnout ta dve pismena"). A translate rather than four
         rewritten paths: her traced outlines stay exactly as drawn, and the
         amount is one number to change. Ten is as far as it goes before the
         bowl starts covering the K's upper arm. -->
    <g fill="currentColor" transform="translate(-10,0)">
      <path d="M91 44 H125 V54 H91 Z"/>
      <path d="M101 44 H115 V162 H101 Z"/>
      <path d="M89 153 H127 V162 H89 Z"/>
      <path d="M115 50
               C145 50 169 63 169 88
               C169 113 145 126 115 126
               L115 112
               C137 112 155 102 155 88
               C155 74 137 64 115 64
               Z"/>
    </g>
  </g>

  <!-- sparkles off the right shoulder -->
  <g class="kp-frame" fill="currentColor">
    <path d="M172 34 l3.2 10.5 l10.5 3.2 l-10.5 3.2 l-3.2 10.5 l-3.2 -10.5 l-10.5 -3.2 l10.5 -3.2 Z"/>
    <path d="M181 68 l2.2 7 l7 2.2 l-7 2.2 l-2.2 7 l-2.2 -7 l-7 -2.2 l7 -2.2 Z"/>
    <path d="M154 30 l1.7 5.4 l5.4 1.7 l-5.4 1.7 l-1.7 5.4 l-1.7 -5.4 l-5.4 -1.7 l5.4 -1.7 Z"/>
  </g>
</svg>
)}
