---
// One performance date, as the client described it twice in the same message
// (2026-08-31): "název a čas a datum zarovnat pod sebe a vedle toho mini
// plakat" for the homepage, and the same block plus running time and age for
// the program page. She described one block, so this is one component used in
// both places rather than two that drift apart.
import { czechDate, czechDuration } from '../lib/program.js';
import { standIn } from '../lib/stand-in.js';
import ProductionTitle from './ProductionTitle.astro';

interface Props {
  entry: {
    date: string;
    time: string;
    title: string;
    slug?: string;
    note?: string;
    url?: string;
    state: string;
  };
  // The production this date belongs to, when it has a page. Toníkova cesta
  // and Červánky have neither, so they render the title and nothing else -
  // which is correct until those pages exist.
  production?: { data: Record<string, any> };
  // Set on the program page so the calendar above has something to link a day
  // to. Omitted everywhere else rather than minted unconditionally: an id is
  // a promise that something links here, and two of these on one page would
  // be a duplicate id.
  id?: string;
}

const { entry, production, id } = Astro.props;
const data = production?.data;

// Running time and recommended age, as two tags rather than one run of text
// (2026-09-07: "dal bych ke kazde hre pridal tagy. obsahovat budou dobu
// trvani, a doporuceny vek"). Order is fixed: how long, then who for.
const tags = [
  data?.durationMinutes && czechDuration(data.durationMinutes),
  data?.ageRating,
].filter(Boolean);

// A photograph rather than a grey blank where no poster exists (2026-09-09).
// It is always labelled: see src/lib/stand-in.js for why the bubble is the
// half that matters, and why the pool excludes anything showing the Rychlé
// šípy set.
const picture = data?.poster ?? standIn(entry.title);
const awaitingPoster = !data?.poster;
---
<article class="ticket" id={id} data-state={entry.state}>
  <div class="ticket__poster">
    <img
      src={picture.src}
      width={picture.width}
      height={picture.height}
      alt={picture.alt}
      data-placeholder={awaitingPoster ? '' : undefined}
      loading="lazy"
    />
  </div>

  <div class="ticket__body">
    <p class="ticket__title display">
      {entry.slug
        ? <a href={`/repertoar/${entry.slug}/`}>
            {data
              ? <ProductionTitle titleLead={data.titleLead} titleRest={data.titleRest} />
              : entry.title}
          </a>
        : entry.title}
    </p>
    <p class="ticket__time display">{entry.time}</p>
    <p class="ticket__day">{czechDate(entry.date)}</p>

    {entry.note && <p class="ticket__note">{entry.note}</p>}

  </div>

  {/* Outside .ticket__body on purpose: these are pinned to the card's corner,
      so they are positioned against the card rather than flowing after the
      text. Labelled, because "80 min" and "12+" alone say nothing when read
      out in sequence away from the card they are stuck to. */}
  <div class="ticket__bubbles">
    {tags.length > 0 && (
      <ul class="ticket__tags" aria-label="Délka a doporučený věk">
        {tags.map((tag) => <li class="ticket__tag">{tag}</li>)}
      </ul>
    )}

    {/* Says what the blank used to say by being blank, and stops the
        photograph above it from claiming to be this production's poster. */}
    {awaitingPoster && <span class="ticket__bubble">Připravujeme</span>}

    {/* Rightmost, and the only red on the card: it is the one thing here
        anybody came to do. Still absent rather than empty when GoOut has no
        ticket for this date - a "Vstupenky" going nowhere is worse than none.
        Moved out of the card's body 2026-09-09, because a link that flows
        after the text made cards with tickets taller than cards without and
        the row stopped lining up. */}
    {entry.url && <a class="ticket__bubble ticket__bubble--tickets" href={entry.url}>Vstupenky</a>}
  </div>
</article>
