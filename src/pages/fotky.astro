---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductionTitle from '../components/ProductionTitle.astro';

// Every photograph here comes from a production's own file, grouped under
// that production's title. The photographer's set arrived on 2026-11-20
// already sorted by show, so each one is attributed by her sorting, not by
// our reading of the set - misattributing someone else's production is the
// error this page used to guard against by captioning almost nothing.
//
// The grey panels that stood here before (and hero.png, captioned "Soubor")
// are gone from this page; they still serve src/lib/stand-in.js, which is a
// separate job. A production with no photographs yet simply has no group.
const productions = (await getCollection('productions'))
  .filter((production) => production.data.photos.length > 0)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Fotky — Kolekce Parchant" description="Fotografie z představení souboru Kolekce Parchant ve Studiu Citadela.">
  <section class="page fotky">
    <div class="page__inner">
      <h1 class="display page-heading">Fotky</h1>

      {productions.map((production, productionIndex) => (
        <section class="fotky__group">
          <h2 class="display fotky__title">
            <a href={`/repertoar/${production.id}/`}>
              <ProductionTitle titleLead={production.data.titleLead} titleRest={production.data.titleRest} />
            </a>
          </h2>

          <div class="gallery">
            {production.data.photos.map((photo, photoIndex) => (
              // The one hook the actors-moving animation will attach to
              // (backlog: the-actors-moving-animation). Nothing reads it yet.
              <figure class="gallery__item" data-animate={productionIndex === 0 && photoIndex === 0 ? 'hero' : undefined}>
                <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .fotky { background: transparent; }

  .fotky__group + .fotky__group { margin-top: 3rem; }

  .fotky__title { margin: 0 0 1.25rem; font-size: clamp(1.6rem, 6vw, 2.4rem); }

  .fotky__title a { color: inherit; text-decoration: none; }

  .fotky__title a:hover { text-decoration: underline; }

  /* Columns, as on the production pages: the set mixes upright and wide
     frames, and columns keep each whole without leaving holes. */
  .gallery { columns: 1; column-gap: 1rem; }

  @media (min-width: 48rem) { .gallery { columns: 2; } }

  .gallery__item { margin: 0 0 1rem; break-inside: avoid; }

  .gallery__item img { display: block; width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-inner); }
</style>
