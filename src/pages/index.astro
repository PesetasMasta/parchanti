---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PerformanceDate from '../components/PerformanceDate.astro';
import ProductionTitle from '../components/ProductionTitle.astro';
import program from '../../data/program.json';
import goout from '../../data/goout.json';
import { upcoming, withTickets } from '../lib/program.js';
import { standIn } from '../lib/stand-in.js';

const productions = (await getCollection('productions'))
  .sort((a, b) => a.data.order - b.data.order);
const productionOf = new Map(productions.map((production) => [production.id, production]));

// The next performances still to be played, not simply the first lines of
// the file. Until the dates carried an ISO field nothing could compare them
// to today, so this strip would have gone on advertising 17. 9. from 18. 9.
// onwards. check.mjs fails the build if the first date shown here is behind
// it, so slot 0 stays the soonest one.
//
// Six, not one: the strip turns through them like the festival drum on
// radiobloodstream.com. More than six and the dots stop being countable at a
// glance, which is the only thing they are for.
const drumDates = upcoming(withTickets(program.dates, goout)).slice(0, 6);

// Titles she performs that have no page in the repo yet - Toníkova cesta and
// Červánky. Taken from her own programme rather than typed here, so the strip
// cannot claim a production she has stopped playing, and so a new title
// arrives on the page the moment it arrives in her dates. They render as
// title-only cards: there is no blurb, no photograph and no cast for either,
// and inventing one is the failure mode this repo guards hardest against.
const otherTitles = [...new Set(program.dates.filter((date) => !date.slug).map((date) => date.title))];

// The card she asked for is the poster (its own back turns to it with a
// button reading "Plakát"), so the front carries the poster and not, as it
// did until 2026-09-09, the first photograph in the gallery. Where no poster
// exists it carries a labelled photograph instead - see src/lib/stand-in.js.
const deckCards = productions.map((production) => ({
  production,
  picture: production.data.poster ?? standIn(production.data.titleLead),
  awaitingPoster: !production.data.poster,
  // A card turns over onto its blurb, so a production without one has no back
  // and must not offer a button to it. Červánky arrived 2026-09-11 with the
  // long annotation and no one-line blurb, which is the first time a
  // production with its own page has been in this state.
  turns: Boolean(production.data.blurb),
}));

const otherCards = otherTitles.map((title) => ({ title, picture: standIn(title) }));

const description = 'Kolekce Parchant je nezávislý divadelní soubor ze Studia Citadela v Praze. Rychlé šípy a záhada klubovny, Hra lásky a náhody.';
---
<Base title="Kolekce Parchant" description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'TheaterGroup',
    name: 'Kolekce Parchant',
    url: 'https://kolekceparchant.cz',
    location: {
      '@type': 'PerformingArtsTheater',
      name: 'Studio Citadela',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Klimentská 16',
        addressLocality: 'Praha 1',
        addressCountry: 'CZ',
      },
    },
    sameAs: [
      'https://www.instagram.com/kolekce_parchant',
      'https://www.i-divadlo.cz/divadlo/kolekce-parchant',
    ],
  })} />

  <!-- The hero turns by itself through three slides, one per section, each
       with its own button (client, 2026-09-02/03). The first slide is the
       identity one and carries everything the page owns: the h1, the claim
       slot still waiting on her, and her pitch verbatim. It is also the only
       slide in normal flow - the other two are laid over it - so the tallest
       slide sets the height and the strip cannot jump as it turns. -->
  <section class="hero page" data-reel>
    <article class="hero__slide" data-on>
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Nezávislé divadlo &middot; Praha</p>
          <h1 class="display hero__title">Kolekce Parchant</h1>

          <!-- The short claim under the name is still pending from the client.
               Deliberately separate from the pitch below: the backlog lists
               them as two different items. Leave empty rather than inventing
               one. -->
          <p class="hero__claim" data-placeholder></p>

          <p class="hero__pitch">Divadelní soubor, který se nebojí provokovat. Jsme tu abychom bourali hranice a vytvářeli nezapomenutelné zážitky!</p>

          <p><a class="button" href="/program/">Program</a></p>
        </div>
      </div>
    </article>

    <article class="hero__slide">
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Repertoár</p>
          <p class="display hero__title">Co hrajeme</p>
          <p class="hero__pitch">Inscenace, které máme na repertoáru.</p>
          <p><a class="button" href="/repertoar/">Repertoár</a></p>
        </div>
      </div>
    </article>

    <article class="hero__slide">
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Soubor</p>
          <p class="display hero__title">Kdo jsme</p>
          <p class="hero__pitch">Lidé, kteří Kolekci Parchant tvoří.</p>
          <p><a class="button" href="/soubor/">Soubor</a></p>
        </div>
      </div>
    </article>

    <!-- Somewhere to press, and a place that says how many there are and
         which one this is. Outside the slides so it does not fade with
         them. -->
    <!-- One row of controls, arrows either side of the dots (2026-09-09:
         "presun z boku k teckam"). Off the sides of the picture and gathered
         with the dots, they read as one set of controls for one reel rather
         than as two things that happen to move it.
         The arrows are for the pointer and revealed on hover; the dots stay
         the control a keyboard and a thumb use, so hiding the arrows until
         hover costs nobody anything. -->
    <div class="hero__controls">
      <button class="hero__step" type="button" data-reel-prev aria-label="Předchozí sekce">&lsaquo;</button>
      <div class="hero__dots" role="group" aria-label="Sekce">
        <button class="hero__dot" type="button" aria-label="Program" aria-current="true"></button>
        <button class="hero__dot" type="button" aria-label="Repertoár"></button>
        <button class="hero__dot" type="button" aria-label="Soubor"></button>
      </div>
      <button class="hero__step" type="button" data-reel-next aria-label="Další sekce">&rsaquo;</button>
    </div>
  </section>

  <section class="next page">
    <div class="page__inner">
      <!-- No upcoming dates is the normal launch state, said honestly. -->
      {drumDates.length === 0 ? (
        <Fragment>
          <div class="next__head"><h2 class="next__eyebrow">Nejbližší představení</h2></div>
          <div class="next__empty">
            <p>Zatím žádný vypsaný termín. Jakmile vypíšeme nové, najdete je tady.</p>
            <p><a class="link" href="https://www.instagram.com/kolekce_parchant">Sledovat na Instagramu</a></p>
          </div>
        </Fragment>
      ) : (
        <div class="drum" data-drum>
          <div class="next__head">
            <h2 class="next__eyebrow">Nejbližší představení</h2>
            <!-- Filled in by script, never by the build: this is a static
                 site, so a countdown rendered at build time is wrong from the
                 next midnight onward. Empty and hidden until the browser has
                 a clock, which is also why it carries no fallback text. -->
            <p class="drum__countdown" data-countdown hidden></p>
          </div>

          <div class="drum__window" data-drum-window>
            {drumDates.map((date, index) => (
              <div class="drum__slide" data-date={date.date} data-index={index}>
                <PerformanceDate entry={date} production={date.slug ? productionOf.get(date.slug) : undefined} />
              </div>
            ))}
          </div>

          <!-- The drum is a drag, which is not a gesture a mouse offers and
               not one a keyboard has. The arrows are how it is worked without
               one (2026-09-08: "add arrows to it? to by more desktop
               friendly"). -->
          <div class="drum__nav">
            <button class="drum__step" type="button" data-drum-prev aria-label="Předchozí termín">&lsaquo;</button>
            <div class="drum__dots" role="group" aria-label="Termíny">
              {drumDates.map((date, index) => (
                <button
                  class="drum__dot"
                  type="button"
                  aria-label={date.when}
                  aria-current={index === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
            <button class="drum__step" type="button" data-drum-next aria-label="Další termín">&rsaquo;</button>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="teaser page">
    <div class="page__inner">
      <h2 class="display page-heading teaser__heading">Repertoár</h2>
      <!-- Scrolls sideways rather than stacking: there are four titles now,
           not two, and a 2x2 grid of them pushes the rest of the page below
           the fold on a phone. -->
      <div class="deck-stage">
        <div class="deck__frame">
        <div class="deck" data-deck role="group" aria-roledescription="balíček karet" aria-label="Repertoár" tabindex="0">
          {deckCards.map(({ production, picture, awaitingPoster, turns }) => (
            <div class="deck__card" data-flippable={turns ? true : undefined}>
              <div class="deck__flip">
                <article class="production-card deck__face">
                  <div class="production-card__picture">
                    <img
                      src={picture.src}
                      width={picture.width}
                      height={picture.height}
                      alt={picture.alt}
                      data-placeholder={awaitingPoster ? '' : undefined}
                      loading="lazy"
                    />
                    {awaitingPoster && <span class="production-card__bubble">Připravujeme</span>}
                  </div>
                  <h3 class="display production-card__title">
                    <ProductionTitle titleLead={production.data.titleLead} titleRest={production.data.titleRest} />
                  </h3>
                  <!-- The poster side carries one control and no link
                       (2026-09-08: "change Popis btn to i button and remove
                       link vice o inscenaci from poster side"). The way to
                       the production page is on the back, next to the text
                       that would make someone want it. -->
                  <div class="deck__foot">
                    {turns
                      ? <button class="deck__turn deck__turn--info" type="button" data-flip aria-label="Popis inscenace">i</button>
                      : <a class="link" href={`/repertoar/${production.id}/`}>Více o inscenaci</a>}
                  </div>
                </article>

                {turns && (
                  <article class="production-card deck__face deck__face--back">
                    <h3 class="display production-card__title">
                      <ProductionTitle titleLead={production.data.titleLead} titleRest={production.data.titleRest} />
                    </h3>
                    <p class="deck__blurb">{production.data.blurb}</p>
                    <div class="deck__foot">
                      <a class="link" href={`/repertoar/${production.id}/`}>Více o inscenaci</a>
                      <button class="deck__turn" type="button" data-flip>Plakát</button>
                    </div>
                  </article>
                )}
              </div>
            </div>
          ))}

          {/* Title and nothing else, and no back to turn to: there is no
              blurb for either of these, and a blank reverse that says nothing
              is worse than a card that does not turn. */}
          {otherCards.map(({ title, picture }) => (
            <div class="deck__card">
              <div class="deck__flip">
                <article class="production-card deck__face">
                  <div class="production-card__picture">
                    <img
                      src={picture.src}
                      width={picture.width}
                      height={picture.height}
                      alt={picture.alt}
                      data-placeholder
                      loading="lazy"
                    />
                    <span class="production-card__bubble">Připravujeme</span>
                  </div>
                  <h3 class="display production-card__title">{title}</h3>
                  <p class="production-card__note">Hrajeme. Stránka inscenace se připravuje.</p>
                </article>
              </div>
            </div>
          ))}
        </div>

        <!-- The deck is a drag, which is not an instruction anyone can see and
             not a gesture a keyboard has. These are how it is worked without
             one, which is why they are arrows over the deck's edges rather
             than the "Zpět"/"Další" pair they replaced (2026-09-09) - the
             labelled buttons sat in a bar below and read as the page's
             furniture rather than as the deck's own controls.
             Named for a screen reader, since a glyph is not a name. -->
          <button class="deck__step deck__step--prev" type="button" data-deck-prev aria-label="Předchozí inscenace">&lsaquo;</button>
          <button class="deck__step deck__step--next" type="button" data-deck-next aria-label="Další inscenace">&rsaquo;</button>
        </div>

        <p class="deck__count" data-deck-count></p>

        <!-- Announced, not shown. The visible count is a few glyphs wide on
             purpose - printing the title there wrapped it to three lines
             between the two buttons and pushed them to the screen edges. The
             title still has to be said, because "3 / 4" on its own does not
             tell anyone what was just dealt. -->
        <p class="deck__live" data-deck-live aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The strip is its own dark band rather than a block on the wash, so it
     drops the page padding and paints edge to edge. */
  /* The band belongs to the reel, not to the slide (2026-09-06: "u hero
     nemenit tmavy pruh, jen fotku a napis"). It used to be painted by each
     slide's own copy, so cross-fading two slides cross-faded two identical
     ink bands and the band dipped in the middle of every turn - a flicker on
     the one surface that should have been the still thing.

     Painting it here instead means the band is simply always there. It also
     keeps the contrast harness honest: it walks up for a background-COLOUR,
     finds this one, and measures the white copy against real ink. */
  .hero {
    position: relative;
    padding: 0;
    background: var(--ink);
    /* The slides now stand beside each other and travel through this box, so
       it has to clip them - without this the two off-screen slides widen the
       document and the page scrolls sideways, which check.mjs fails on. */
    overflow: hidden;
    /* --hero-photo went with the photographs (2026-09-11: "fotky z hero
       uplne pryc"). It existed only to keep the picture's height and the room
       the slides left above their copy in step, and there is no picture now:
       the band is type on ink, which is what the rest of the site already is.
       The dithered edge that faded the photograph into the band went too -
       there is nothing left to fade, and the band is one colour throughout. */
    /* Vertical drags belong to the page. Without this the reel eats the
       scroll on a phone and the top of the site becomes a trap. */
    touch-action: pan-y;
  }

  /* Only the first slide is in flow. The other two are laid over it, so the
     identity slide - the one with the most words in it - decides the height
     and the strip never resizes as it turns. */
  /* The slides travel sideways rather than cross-fading (2026-09-09: "ted je
     to neprirozene tim ze mame tecky horizontalne"). The dots below are a row,
     so they promise a row: three things side by side that you move along.
     A fade promised a stack and the two cues disagreed.
     The transform is written by script, which is what knows where each slide
     stands relative to the one showing. */
  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Was the picture's height; now simply room above the words so they do
       not sit jammed under the bar. */
    padding-top: clamp(3rem, 14vw, 7rem);
    /* Stacked slides would otherwise sit over the showing slide's button. */
    pointer-events: none;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: none; }
  }

  .hero__slide[data-on] { pointer-events: auto; }

  /* Padding, not a margin on the copy: the slide has no border or padding of
     its own, so a top margin on its first child collapses straight through it
     and moves the slide instead of making room inside it - which left the
     photograph with nowhere to be and the wash showing where it should have
     been. */
  .hero__slide:first-child { position: relative; }

  /* No background of its own any more - .hero paints the band for the whole
     reel. Transparent here is safe rather than sloppy: the harness's walk up
     the tree finds .hero's ink, so the white copy is still measured against
     the colour it is actually printed on.

     The band carries the page gutter itself, because .hero drops the padding
     .page would have given it in order to paint edge to edge. */
  .hero__copy {
    position: relative;
    z-index: 2;
    flex: 1;
    padding: 1.75rem var(--gutter) 2.25rem;
    color: var(--white);
  }

  /* The three reel buttons are the only ones on the site printed on the dark,
     and with one ink an ink button on the ink band is invisible. So here it
     inverts: white fill, ink lettering, same 15.9:1 either way round. Scoped
     to .hero rather than to a dark-band token, because .hero is the only dark
     band that carries a button. */
  .hero .button {
    background: var(--white);
    color: var(--ink);
    border-color: var(--white);
  }

  /* visibility, not opacity: it is what takes the copy of a slide nobody is
     looking at out of the tab order, so the hidden slides' buttons cannot be
     reached with a keyboard. */
  .hero__copy > .page__inner {
    visibility: hidden;
    transition: visibility 0s linear 900ms;
  }

  .hero__slide[data-on] .hero__copy > .page__inner {
    visibility: visible;
    transition: visibility 0s;
  }

  /* The copy arrives after the picture has settled, one line at a time, and
     leaves together - the same two beats as the menu. */
  .hero__copy > .page__inner > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 420ms ease, transform 420ms ease;
  }

  .hero__slide[data-on] .hero__copy > .page__inner > * { opacity: 1; transform: none; }

  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(1) { transition-delay: 260ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(2) { transition-delay: 340ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(3) { transition-delay: 420ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(4) { transition-delay: 500ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(5) { transition-delay: 580ms; }

  .hero__controls {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1rem;
    display: flex;
    align-items: center;
  }

  .hero__dots { display: flex; gap: 0.15rem; }

  /* Plain glyphs, the same as the deck's, in the white the dots are drawn in
     because this row sits on the ink band. */
  .hero__step {
    display: none;
    place-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Only where a pointer can hover. On touch the reel is dragged and the dots
     are already there, so the arrows would be two more things covering the
     photograph for no gain. :focus-visible brings them back for a keyboard. */
  @media (hover: hover) {
    .hero__step { display: grid; opacity: 0; transition: opacity 160ms ease; }
    .hero:hover .hero__step,
    .hero__step:focus-visible { opacity: 1; }
  }

  /* The mark is small but the target is not: 44px of button around a 10px
     dot, which is what a thumb needs and what the dots must not look like. */
  .hero__dot {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-content: center;
  }

  .hero__dot::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 2px solid var(--white);
    background: transparent;
    transition: background-color 200ms ease;
  }

  .hero__dot[aria-current]::before { background: var(--white); }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.8rem;
    color: var(--white);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.4rem, 11vw, 5rem);
    line-height: 1;
    color: var(--white);
  }

  .hero__claim:empty { display: none; }

  .hero__pitch {
    max-width: var(--measure);
    margin: 1.25rem 0;
    font-size: clamp(1.05rem, 1rem + 0.6vw, 1.3rem);
    font-weight: 600;
    text-wrap: pretty;
  }

  .next__eyebrow {
    margin: 0 0 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .next__empty {
    max-width: var(--measure);
    padding: 1.5rem;
    border: 3px dashed var(--ink);
    border-radius: var(--radius-card);
  }

  .next__empty p { margin: 0 0 0.75rem; }
  .next__empty p:last-child { margin-bottom: 0; }

  .teaser { background: transparent; }

  /* A deck, not a row (2026-09-06). Four plays is a hand of cards, and a hand
     is a thing you deal through rather than scroll past - the top card gets
     the whole width instead of a quarter of it.

     The stage is what reserves the room. The deck itself is an aspect box and
     every card is absolutely positioned inside it, so the cards behind cannot
     add height; the fan leans them out past that box, which is what the
     stage's bottom padding is for. */
  /* Over the deck, which is centred in the page: a left-aligned heading above
     a centred stack of cards read as two different columns. */
  .teaser__heading { text-align: center; }

  .deck-stage { padding-bottom: 0.5rem; }

  .deck {
    position: relative;
    width: min(22rem, 82vw);
    margin-inline: auto;
    /* Sized from the picture inside it, measured rather than guessed: the
       title, the foot and the padding come to 221px at this width, so the
       card is the square picture plus that. A 3/4 picture made this 629px
       tall and read as too big (2026-09-09); square brings it back to 527,
       within reach of the 469 it was before any of this. */
    aspect-ratio: 0.67;
    /* Depth for the turn. Set on the deck rather than the card so every card
       is seen from the same eye, which is what keeps the fan coherent. */
    perspective: 1400px;
    /* Vertical drags belong to the page. Without this the deck eats the
       scroll on a phone and the section becomes a trap. */
    touch-action: pan-y;
  }

  .deck:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }

  /* The card is now only a place in the deck: where it sits, how it leans,
     what it is dragged by. Everything you can see belongs to the two faces
     inside it, because the deal and the turn are different transforms and one
     element cannot carry both. */
  .deck__card {
    position: absolute;
    inset: 0;
    cursor: grab;
    /* Rotating about a point below the card swings it like a card held at its
       corner, rather than spinning it about its middle. */
    transform-origin: 50% 120%;
    user-select: none;
  }

  .deck__card[data-dragging] { cursor: grabbing; }

  .deck__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .deck__card[data-flipped] .deck__flip { transform: rotateY(180deg); }

  .deck__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    backface-visibility: hidden;
    box-shadow: 0 10px 24px rgb(var(--ink-rgb) / 0.22);
  }

  .deck__face--back { transform: rotateY(180deg); }

  /* Portrait, because a poster is (2026-09-09: "plakaty 4:3 ale opacne takze
     3:4"). The ratio is on the wrapper rather than the image so it can SHRINK
     rather than overflow: `flex: 0 1 auto` takes the full 3/4 when the card
     has room for it and gives height back to the title if a long one wraps to
     a third line. That is what stops the Rychlé šípy card pushing its own
     button out from under it, which is how the fixed ratio failed before.
     Cropped, so all four cards read as one set whatever shape the artwork
     arrives in; the whole poster is a tap away on the production page. */
  .deck__face .production-card__picture {
    flex: 0 1 auto;
    min-height: 0;
    /* Square. 4:5 was the other candidate and was measured first: it saved
       26px of the 160 that needed to go, which is not an answer to a card
       that is too tall. Square saves 102px and still gives a portrait poster
       far more room than the 4:3 landscape band it replaced. */
    aspect-ratio: 1 / 1;
  }

  .deck__face img { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; }

  .deck__face .production-card__blank { aspect-ratio: 1 / 1; object-fit: cover; }

  /* A long blurb scrolls inside the card rather than pushing the foot off it:
     the card cannot grow, because its size is the deck's. */
  .deck__blurb { margin: 0; overflow-y: auto; font-size: 0.95rem; }

  /* Pinned to the bottom of the face, so the link sits on the same line
     whatever the title above it did. */
  .deck__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .deck__foot p { margin: 0; }

  /* Quieter than the deal buttons under the deck: turning a card over is a
     smaller act than dealing the next one, and it should not compete with
     the link beside it. */
  .deck__turn {
    flex: none;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 3px solid var(--accent);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--accent);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* A letter, not a word. Round, so it reads as a marker rather than as the
     card's second button, and labelled for anyone who cannot see that it is
     an i. */
  .deck__turn--info {
    width: 2.75rem;
    min-width: 2.75rem;
    padding: 0;
    margin-left: auto;
    border-radius: 50%;
    font-family: var(--display);
    font-size: 1.15rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .deck__frame { position: relative; }

  /* Over the deck's own edges, because there is no room beside it: the deck
     is 82vw on a phone, which leaves about 29px a side - under the 44px a
     control has to be. Vertically centred on the card rather than on the
     stage, so the arrows sit against the artwork and not against the fan
     leaning out below it. */
  .deck__step {
    position: absolute;
    top: 38%;
    transform: translateY(-50%);
    z-index: 2;
    /* Hidden by default and turned back on only under @media (hover: hover)
       below, mirroring .hero__step (2026-09-15: "skryt sipky na repertoar
       cards na mobilu. melo by byt viditelne jen on mouse hover"). On a phone
       the deck is dragged, which is the native gesture, and .deck__count still
       says where in the pack you are. */
    display: none;
    place-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    /* No disc behind them (2026-09-09: "jednoduchý < > bez kolecka"), so the
       glyph has to survive whatever the poster puts under it. A white halo
       rather than a filled chip: it is invisible over the page's own white
       and only does anything where the arrow crosses artwork. */
    text-shadow: 0 0 4px var(--paper), 0 0 8px var(--paper);
  }

  .deck__step--prev { left: -1rem; }
  .deck__step--next { right: -1rem; }

  /* They exist only where there is a pointer that can hover, and are revealed
     by hovering the frame (2026-09-09: "reveal on hover"). They used to stay
     visible on touch on the argument that a hover-only control does not exist
     on a phone and these were the deck's only alternative to dragging it;
     2026-09-15 settled that the other way - dragging IS the phone's answer.
     :focus-visible brings them back for a keyboard, which has no hover
     either. */
  @media (hover: hover) {
    .deck__step { display: grid; opacity: 0; transition: opacity 160ms ease; }
    .deck__frame:hover .deck__step,
    .deck__step:focus-visible { opacity: 1; }
  }

  .deck__count {
    margin: 3.5rem 0 0;
    font-family: var(--display);
    font-size: 0.95rem;
    white-space: nowrap;
    text-align: center;
  }

  /* Present to a screen reader, absent to everything else. Not display:none,
     which would take it out of the accessibility tree and silence it. */
  .deck__live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .production-card__note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink);
  }

  /* "Rám inscenaci hra lásky a šípy - červenej rám" (2026-08-31, item 4).
     The inner picture frame stays ink, so the card reads as a red mount
     around a black-framed image rather than as two red rules. */
  .production-card { padding: 1.25rem; background: var(--paper); background-clip: padding-box; border: 3px solid var(--ink); border-radius: var(--radius-card); }

  /* The same pinned badge the date cards use, and here for the same reason:
     it is what stops a photograph in a poster's place from being read as the
     poster. Pinned to the picture's lower right, straddling its frame. */
  .production-card__picture { position: relative; }

  .production-card__bubble {
    position: absolute;
    right: 0.75rem;
    bottom: 0;
    transform: translateY(50%);
    padding: 0.22rem 0.6rem;
    background: var(--ink);
    color: var(--white);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    box-shadow:
      0 0 0 3px var(--paper),
      0 0 0 4px rgb(var(--ink-rgb) / 0.16),
      0 5px 12px rgb(var(--ink-rgb) / 0.42);
  }

  .production-card img,
  .production-card__blank { display: block; width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-inner); }

  .production-card__blank { aspect-ratio: 900 / 750; background: var(--ground-deep); }

  .production-card__title { margin: 1rem 0 0.5rem; font-size: clamp(1.5rem, 6vw, 2.2rem); }

  /* --- the hero meets the page --------------------------------------------

     A hard edge, as of 2026-09-15 ("dejme pryc uplne gradient zpode hero a
     nad footer"). The dithered seam that used to carry the ink band into the
     wash is gone, and so is the 192px of top padding that existed only as its
     safety margin - .next inherits .page's own --band-padding now, which is
     what every other band on the site uses.

     The mirror above the footer went with it; see .footer in global.css. */

  /* --- the drum ------------------------------------------------------------

     One date at a time, turning by itself, after the festival drum on
     radiobloodstream.com. The dates are a queue rather than a list: the next
     one is the answer to the question the section asks, and the ones behind
     it are there for anyone who wants to look further.

     Full content width, not the reading measure (2026-09-06: "nejblizsi
     predstaveni roztahni na sirku kontentu"): the ticket is a poster beside a
     few short lines, not a paragraph, so the measure was constraining
     something that is not prose. */
  .drum {
    max-width: none;
    /* How far the clip stands off the ticket on every side, so the shadow can
       fade out instead of being cut. 1rem clears the 24px blur's 12px lateral
       reach and stays inside the page gutter at its 1.25rem narrowest, so
       pulling the window out by it cannot make the page scroll sideways.

       Read by the script as well: the slides either side have to travel this
       much further, or they show through the room the shadow was given. */
    --drum-bleed: 1rem;
  }

  .next__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .next__head .next__eyebrow { margin: 0; }

  /* A stamp on the ticket, and the one place on the wash that carries the
     full cherry as a fill rather than as ink: white on it is 7.5:1, so the
     badge is readable wherever the drum happens to be. */
  .drum__countdown {
    margin: 0;
    padding: 0.3rem 0.7rem;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius-button);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  /* Every slide is stacked in the same grid cell, so the tallest one sets the
     height and the window cannot resize as it turns - the same reason the
     hero keeps its first slide in flow. transform does not affect layout, so
     moving the slides sideways leaves that height alone.

     touch-action: pan-y hands vertical drags back to the page: the drum is
     halfway down a scrolling document and must never trap a scroll. */
  .drum__window {
    display: grid;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    /* Room for the ticket's drop shadow inside the clip (2026-09-07: "stin
       more like repertoar cards. ted je to spis reflection").

       It always WAS the same shadow the repertoire cards carry - the deck is
       not clipped, this window is, and overflow:hidden was cutting the falloff
       off about 5px under the card. What is left of a 24px blur after 5px is a
       hard dark line hugging the bottom edge, which is exactly what a
       reflection looks like and nothing like a cast shadow.

       The sides still clip - the dates either side of this one must not show -
       but the clip now stands off the ticket by --drum-bleed rather than
       cutting flush against it (2026-09-07: "i still dont like this hard edge.
       i would prefer soft shadow around all the strip"). Pulled out by the
       same amount it pads, so the room comes out of the page gutter and the
       ticket keeps the full content width she asked for. */
    padding: 1rem var(--drum-bleed) 2.5rem;
    margin-inline: calc(var(--drum-bleed) * -1);
  }

  .drum__window[data-dragging] { cursor: grabbing; }

  .drum__slide {
    grid-area: 1 / 1;
    min-width: 0;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* A drag must not leave a half-selected paragraph behind it. */
  .drum__window[data-dragging] .drum__slide { user-select: none; }

  /* Pulled up into the room the window leaves for the ticket's shadow
     (2026-09-08: "move dots closer to the cards"). That padding cannot be
     taken back - it is what stops the shadow being clipped into a hard line -
     but the controls can sit inside it, where the shadow is already almost
     nothing. */
  .drum__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-top: -1.4rem;
  }

  /* 44px of button around a glyph, same as the dots beside them - and never
     squeezed below it, which is what flex does to them by default.

     Shown from 40rem up only. Six dots at their own 44px already fill a
     phone, so the arrows there would either overflow the row or shrink both
     out of reach; on touch the strip is dragged anyway, and the arrows are
     for the pointer that cannot drag it (2026-09-08: "to by more desktop
     friendly"). */
  .drum__step {
    display: none;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    place-content: center;
  }

  @media (min-width: 40rem) {
    .drum__step { display: grid; }
  }

  /* Revealed on hover, like the hero's and the deck's (2026-09-09). The dots
     beside them are always there and are what a keyboard and a thumb use, so
     the arrows can stay out of the way until a pointer comes near the strip.
     :focus-visible brings them back for a keyboard that tabs into them. */
  @media (min-width: 40rem) and (hover: hover) {
    .drum__step { opacity: 0; transition: opacity 160ms ease; }
    .drum:hover .drum__step,
    .drum__step:focus-visible { opacity: 1; }
  }

  .drum__dots {
    display: flex;
    justify-content: center;
    gap: 0.15rem;
  }

  /* 44px of button around a 10px dot - what a thumb needs, and what the dot
     must not look like. Same shape as the hero's, in the wash's ink rather
     than the band's white. */
  .drum__dot {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-content: center;
  }

  .drum__dot::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: transparent;
    transition: background-color 200ms ease;
  }

  .drum__dot[aria-current]::before { background: var(--accent); }
</style>

<script>
  // One slide per section, turning by itself. Paused while the tab is hidden:
  // a strip that has advanced six times behind someone's back is showing them
  // a section they never chose to look at.
  const reel = document.querySelector('[data-reel]');
  const slides = [...reel.querySelectorAll('.hero__slide')];
  const dots = [...reel.querySelectorAll('.hero__dot')];
  const count = slides.length;

  const SWIPE_THRESHOLD = 40;
  const ROTATE_MS = 6000;

  let index = 0;
  let previous = 0;
  let dragX = 0;
  let dragging = false;
  let startX = null;
  let startY = null;
  let dragged = false;
  let timer = null;
  let hovered = false;

  // Shortest way round the ring, so the third slide reaches the first by
  // carrying on forwards rather than winding back across the other two.
  const positionFor = (i, at) => {
    let position = i - at;
    if (position > count / 2) position -= count;
    if (position <= -count / 2) position += count;
    return position;
  };

  const layout = () => {
    slides.forEach((slide, i) => {
      const position = positionFor(i, index);
      // A slide that has just wrapped from one end of the ring to the other
      // must jump, not fly back across the picture in front of the reader.
      const wrapped = Math.abs(position - positionFor(i, previous)) > 1;
      slide.style.transition = dragging || wrapped ? 'none' : '';
      slide.style.transform = `translateX(calc(${position * 100}% + ${dragX}px))`;
      if (position === 0) slide.setAttribute('data-on', '');
      else slide.removeAttribute('data-on');
    });

    dots.forEach((dot, i) => {
      if (i === index) dot.setAttribute('aria-current', 'true');
      else dot.removeAttribute('aria-current');
    });
  };

  const go = (next) => {
    previous = index;
    index = (next + count) % count;
    layout();
  };

  const stop = () => { clearInterval(timer); timer = null; };
  const start = () => {
    stop();
    if (count < 2) return;
    // A reel that turns on its own is motion; anyone who has asked for less
    // of it gets the dots, the arrows and the drag instead.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    timer = setInterval(() => {
      if (!dragging && !hovered) go(index + 1);
    }, ROTATE_MS);
  };
  // Someone who has just chosen a slide should get a full turn to read it,
  // not the remainder of a tick that was already running.
  const restart = () => { stop(); start(); };

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { go(i); restart(); });
  });

  reel.querySelector('[data-reel-prev]')?.addEventListener('click', () => { go(index - 1); restart(); });
  reel.querySelector('[data-reel-next]')?.addEventListener('click', () => { go(index + 1); restart(); });

  reel.addEventListener('pointerenter', () => { hovered = true; });
  reel.addEventListener('pointerleave', () => { hovered = false; });

  // Dragged 1:1 by finger or mouse and snapping on release, the same gesture
  // the strip below uses. The slide follows the hand rather than waiting for
  // it to finish, which is the whole difference between a swipe and a button
  // that happens to be a gesture.
  reel.addEventListener('pointerdown', (event) => {
    if (count < 2) return;
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    dragging = true;
    dragged = false;
    startX = event.clientX;
    startY = event.clientY;
  });

  reel.addEventListener('pointermove', (event) => {
    if (startX === null) return;
    const dx = event.clientX - startX;
    const dy = event.clientY - startY;
    // A drag that is mostly vertical is the page being scrolled. Let go of it
    // entirely rather than fighting the scroll for the gesture.
    if (!dragged && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
      startX = null;
      dragging = false;
      dragX = 0;
      layout();
      return;
    }
    // Captured only once a real drag starts: capturing on pointerdown would
    // swallow the click on the slide's own button.
    if (!dragged && Math.abs(dx) > 5) {
      dragged = true;
      reel.setPointerCapture(event.pointerId);
    }
    if (!dragged) return;
    dragX = dx;
    layout();
  });

  const release = () => {
    if (!dragging) return;
    const moved = dragX;
    startX = null;
    dragging = false;
    dragX = 0;
    if (Math.abs(moved) > SWIPE_THRESHOLD) go(index + (moved < 0 ? 1 : -1));
    else layout();
    restart();
  };

  reel.addEventListener('pointerup', release);
  reel.addEventListener('pointercancel', release);

  layout();

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else start();
  });

  start();
</script>

<script>
  // The drum: one performance date in the window, turning by itself, dragged
  // 1:1 by finger or mouse and snapping to the next on release. Ported from
  // the festival strip on radiobloodstream.com, which is React; this is the
  // same behaviour written against the DOM, because nothing else on this site
  // needs a framework and one strip is not a reason to start.
  const drum = document.querySelector('[data-drum]');

  if (drum) {
    const window_ = drum.querySelector('[data-drum-window]');
    const slides = [...drum.querySelectorAll('.drum__slide')];
    const dots = [...drum.querySelectorAll('.drum__dot')];
    const badge = drum.querySelector('[data-countdown]');
    const count = slides.length;

    const SWIPE_THRESHOLD = 40;
    const ROTATE_MS = 8000;

    let slot = 0;
    let previous = 0;
    let dragX = 0;
    let dragging = false;
    let startX = null;
    let startY = null;
    let dragged = false;
    let timer = null;
    let hovered = false;

    // How many days from today to an ISO date, in local calendar days: both
    // ends are floored to midnight, so the answer does not change with the
    // hour of the visit.
    const daysUntil = (iso) => {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const [year, month, day] = iso.split('-').map(Number);
      return Math.round((new Date(year, month - 1, day) - today) / 86400000);
    };

    // Czech counts three ways, and getting it wrong is the kind of thing that
    // makes a site read as machine-written: 1 den, 2-4 dny, 5+ dní. One and
    // zero have words of their own instead.
    const countdownLabel = (iso) => {
      const days = daysUntil(iso);
      if (days < 0) return '';
      if (days === 0) return 'Dnes hrajeme';
      if (days === 1) return 'Zítra';
      if (days < 5) return `Za ${days} dny`;
      // "dní" rather than "dnů" (2026-09-09, developer's ear). Both are
      // standard genitive plurals of "den"; this is the one that reads
      // naturally after a number here.
      return `Za ${days} dní`;
    };

    // Shortest way round the ring, so slide 0 approaches slide 5 from the
    // left rather than travelling back across the whole strip.
    const positionFor = (index, at) => {
      let position = index - at;
      if (position > count / 2) position -= count;
      if (position <= -count / 2) position += count;
      return position;
    };

    const layout = () => {
      slides.forEach((slide, index) => {
        const position = positionFor(index, slot);
        // A slide that has just wrapped from one end of the ring to the other
        // must jump, not fly across the window in front of the reader.
        const wrapped = Math.abs(position - positionFor(index, previous)) > 1;
        slide.style.transition = dragging || wrapped ? 'none' : '';
        // Own width plus the bleed on both sides: a slide moved by exactly
        // its width would stop inside the room left for the shadow and show
        // through it.
        slide.style.transform = `translateX(calc(${position * 100}% + ${position} * var(--drum-bleed) * 2 + ${dragX}px))`;
        // Only the slide in the window is offered to a screen reader or to
        // the tab key; the rest are off-screen and would otherwise scroll the
        // page sideways when focused.
        slide.inert = position !== 0;
        slide.setAttribute('aria-hidden', position === 0 ? 'false' : 'true');
      });

      dots.forEach((dot, index) => {
        if (index === slot) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });

      if (badge) {
        const label = countdownLabel(slides[slot].dataset.date);
        badge.textContent = label;
        badge.hidden = !label;
      }
    };

    const go = (next) => {
      previous = slot;
      slot = (next + count) % count;
      layout();
    };

    // Someone who has just chosen a date should get a full turn to read it,
    // not the remainder of a tick that was already running.
    drum.querySelector('[data-drum-prev]')?.addEventListener('click', () => { go(slot - 1); restart(); });
    drum.querySelector('[data-drum-next]')?.addEventListener('click', () => { go(slot + 1); restart(); });

    const stop = () => { clearInterval(timer); timer = null; };
    const start = () => {
      stop();
      if (count < 2) return;
      // A strip that turns on its own is motion; anyone who has asked for
      // less of it gets the dots and the drag instead.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => {
        if (!dragging && !hovered) go(slot + 1);
      }, ROTATE_MS);
    };
    const restart = () => { stop(); start(); };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => { go(index); restart(); });
    });

    window_.addEventListener('pointerdown', (event) => {
      if (count < 2) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      dragging = true;
      dragged = false;
      startX = event.clientX;
      startY = event.clientY;
      window_.setAttribute('data-dragging', '');
    });

    window_.addEventListener('pointermove', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      // A drag that is mostly vertical is the page being scrolled. Let go of
      // it entirely rather than fighting the scroll for the gesture.
      if (!dragged && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
        startX = null;
        dragging = false;
        dragX = 0;
        window_.removeAttribute('data-dragging');
        layout();
        return;
      }
      if (!dragged && Math.abs(dx) > 5) {
        dragged = true;
        // Captured only once a real drag starts: capturing on pointerdown
        // retargets the eventual click to the window, which swallowed plain
        // taps on the ticket's own links.
        try { window_.setPointerCapture(event.pointerId); } catch { /* pointer already gone */ }
      }
      if (!dragged) return;
      dragX = dx;
      layout();
    });

    const release = (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      dragging = false;
      dragX = 0;
      window_.removeAttribute('data-dragging');
      if (Math.abs(dx) >= SWIPE_THRESHOLD) go(slot + (dx < 0 ? 1 : -1));
      else layout();
      restart();
    };

    window_.addEventListener('pointerup', release);
    window_.addEventListener('pointercancel', release);

    // A drag must not count as a click on the ticket's link.
    window_.addEventListener('click', (event) => {
      if (dragged) {
        event.preventDefault();
        event.stopPropagation();
        dragged = false;
      }
    }, true);

    window_.addEventListener('mouseenter', () => { hovered = true; });
    window_.addEventListener('mouseleave', () => { hovered = false; });

    // A drum that has turned six times behind someone's back is showing them
    // a date they never chose to look at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    layout();
    start();
  }
</script>

<script>
  // The repertoire deck. Drag the top card sideways and let go: past the
  // threshold it is thrown the way you pushed it and goes to the back, short
  // of it it springs back. Four plays, so it loops rather than running out.
  //
  // Only the top card is offered to a screen reader or the tab key. Three
  // stacked cards all announcing themselves under one another is noise, and a
  // link nobody can see is a trap - so the controls below are the accessible
  // way through, and /repertoar/ lists every production as plain text anyway.
  const deck = document.querySelector('[data-deck]');

  if (deck) {
    const cards = [...deck.querySelectorAll('.deck__card')];
    const stage = deck.closest('.deck-stage');
    const count = stage.querySelector('[data-deck-count]');
    const live = stage.querySelector('[data-deck-live]');
    const total = cards.length;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');

    const THROW = 70;

    // Which card is on top, then the one behind it, and so on. Everything the
    // deck knows is in this one array; every card's resting state is derived
    // from its position in it, so there is no per-card bookkeeping to drift.
    let order = cards.map((_, index) => index);
    let busy = false;
    let startX = null;
    let startY = null;
    let dragging = false;

    const titleOf = (card) => card.querySelector('.production-card__title')?.textContent.replace(/\s+/g, ' ').trim() ?? '';

    // The face turned away is still in the document, so it has to be taken
    // out of the tab order and out of the accessibility tree by hand -
    // backface-visibility only hides it from the eye. Without this both
    // "Popis" and "Plakát" are reachable at once and neither makes sense.
    const faces = (card) => {
      const flipped = card.hasAttribute('data-flipped');
      for (const face of card.querySelectorAll('.deck__face')) {
        const back = face.classList.contains('deck__face--back');
        const away = back !== flipped;
        face.inert = away;
        face.setAttribute('aria-hidden', away ? 'true' : 'false');
      }
    };

    const settle = (animate = true) => {
      order.forEach((cardIndex, depth) => {
        const card = cards[cardIndex];
        const lift = depth * 10;
        const turn = depth === 0 ? 0 : (depth % 2 ? -1 : 1) * (2 + depth);
        card.style.transition = animate && !calm.matches
          ? 'transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease'
          : 'none';
        card.style.transform = `translateY(${lift}px) scale(${1 - depth * 0.04}) rotate(${turn}deg)`;
        card.style.zIndex = String(total - depth);
        // The fourth card down is behind two others and contributes nothing
        // but paint; hiding it keeps the stack from muddying at the edges.
        card.style.opacity = depth > 2 ? '0' : '1';
        card.inert = depth !== 0;
        card.setAttribute('aria-hidden', depth === 0 ? 'false' : 'true');
        faces(card);
      });
      count.textContent = `${order[0] + 1} / ${total}`;
      live.textContent = `${order[0] + 1} z ${total}: ${titleOf(cards[order[0]])}`;
    };

    const advance = (direction) => {
      if (busy) return;
      const card = cards[order[0]];
      const rotate = () => {
        // A card dealt to the back goes face up again: it is a poster in a
        // deck, not a page someone left open.
        card.removeAttribute('data-flipped');
        order = [...order.slice(1), order[0]];
        settle(false);
        // One frame at the back with no transition, then the whole deck eases
        // up a place - otherwise the card flies back from where it was thrown.
        requestAnimationFrame(() => settle(true));
      };
      if (calm.matches) {
        rotate();
        return;
      }
      busy = true;
      card.style.transition = 'transform 300ms ease-in, opacity 300ms ease-in';
      card.style.transform = `translateX(${direction * 130}%) rotate(${direction * 18}deg)`;
      card.style.opacity = '0';
      setTimeout(() => { rotate(); busy = false; }, 300);
    };

    // Backwards has nothing to throw - the card is arriving, not leaving - so
    // it simply takes its place at the front and the deck settles around it.
    const retreat = () => {
      if (busy) return;
      cards[order[0]].removeAttribute('data-flipped');
      order = [order[order.length - 1], ...order.slice(0, -1)];
      settle(true);
    };

    // Turning a card over. Its own button rather than a tap anywhere on the
    // card: the card is already a drag target and a link, and a third meaning
    // for the same surface is how you get a flip every time someone means to
    // follow the link.
    deck.addEventListener('click', (event) => {
      const turn = event.target.closest('[data-flip]');
      if (!turn) return;
      const card = turn.closest('.deck__card');
      card.toggleAttribute('data-flipped');
      faces(card);
      // Focus would otherwise stay on a button that has just turned away.
      card.querySelector('.deck__face:not([inert]) [data-flip]')?.focus();
    });

    deck.addEventListener('pointerdown', (event) => {
      if (busy) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (!cards[order[0]].contains(event.target)) return;
      startX = event.clientX;
      startY = event.clientY;
      dragging = false;
      cards[order[0]].setAttribute('data-dragging', '');
    });

    deck.addEventListener('pointermove', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      // A mostly-vertical drag is the page being scrolled; let go of it.
      if (!dragging && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
        startX = null;
        cards[order[0]].removeAttribute('data-dragging');
        settle(true);
        return;
      }
      if (!dragging && Math.abs(dx) > 4) {
        dragging = true;
        // Captured only once a real drag starts: capturing on pointerdown
        // retargets the eventual click and swallowed taps on the card's link.
        try { deck.setPointerCapture(event.pointerId); } catch { /* pointer already gone */ }
      }
      if (!dragging) return;
      const card = cards[order[0]];
      card.style.transition = 'none';
      card.style.transform = `translateX(${dx}px) rotate(${dx / 22}deg)`;
    });

    const drop = (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      cards[order[0]].removeAttribute('data-dragging');
      if (Math.abs(dx) >= THROW) advance(dx < 0 ? -1 : 1);
      else settle(true);
    };

    deck.addEventListener('pointerup', drop);
    deck.addEventListener('pointercancel', drop);

    // A drag must not count as a click on the card's link.
    deck.addEventListener('click', (event) => {
      if (dragging) {
        event.preventDefault();
        event.stopPropagation();
        dragging = false;
      }
    }, true);

    deck.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); advance(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); retreat(); }
    });

    stage.querySelector('[data-deck-next]').addEventListener('click', () => advance(-1));
    stage.querySelector('[data-deck-prev]').addEventListener('click', retreat);

    settle(false);
  }
</script>
