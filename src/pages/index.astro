---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PerformanceDate from '../components/PerformanceDate.astro';
import ProductionTitle from '../components/ProductionTitle.astro';
import program from '../../data/program.json';
import { upcoming } from '../lib/program.js';

const productions = (await getCollection('productions'))
  .sort((a, b) => a.data.order - b.data.order);
const productionOf = new Map(productions.map((production) => [production.id, production]));

// The next performances still to be played, not simply the first lines of
// the file. Until the dates carried an ISO field nothing could compare them
// to today, so this strip would have gone on advertising 17. 9. from 18. 9.
// onwards. check.mjs fails the build if the first date shown here is behind
// it, so slot 0 stays the soonest one.
//
// Six, not one: the strip turns through them like the festival drum on
// radiobloodstream.com. More than six and the dots stop being countable at a
// glance, which is the only thing they are for.
const drumDates = upcoming(program.dates).slice(0, 6);

// Titles she performs that have no page in the repo yet - Toníkova cesta and
// Červánky. Taken from her own programme rather than typed here, so the strip
// cannot claim a production she has stopped playing, and so a new title
// arrives on the page the moment it arrives in her dates. They render as
// title-only cards: there is no blurb, no photograph and no cast for either,
// and inventing one is the failure mode this repo guards hardest against.
const otherTitles = [...new Set(program.dates.filter((date) => !date.slug).map((date) => date.title))];

const description = 'Kolekce Parchant je nezávislý divadelní soubor ze Studia Citadela v Praze. Rychlé šípy a záhada klubovny, Hra lásky a náhody.';
---
<Base title="Kolekce Parchant" description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'TheaterGroup',
    name: 'Kolekce Parchant',
    url: 'https://kolekceparchant.cz',
    location: {
      '@type': 'PerformingArtsTheater',
      name: 'Studio Citadela',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Klimentská 16',
        addressLocality: 'Praha 1',
        addressCountry: 'CZ',
      },
    },
    sameAs: [
      'https://www.instagram.com/kolekce_parchant',
      'https://www.i-divadlo.cz/divadlo/kolekce-parchant',
    ],
  })} />

  <!-- The hero turns by itself through three slides, one per section, each
       with its own button (client, 2026-09-02/03). The first slide is the
       identity one and carries everything the page owns: the h1, the claim
       slot still waiting on her, and her pitch verbatim. It is also the only
       slide in normal flow - the other two are laid over it - so the tallest
       slide sets the height and the strip cannot jump as it turns. -->
  <section class="hero page" data-reel>
    <article class="hero__slide" data-on>
      <img
        class="hero__photo"
        src="/assets/panels/hero.png"
        width="1400"
        height="1077"
        alt="Šest herců stojí vedle sebe v řadě v podkroví s lany a petrolejkou nad hlavou."
      />
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Nezávislé divadlo &middot; Praha</p>
          <h1 class="display hero__title">Kolekce Parchant</h1>

          <!-- The short claim under the name is still pending from the client.
               Deliberately separate from the pitch below: the backlog lists
               them as two different items. Leave empty rather than inventing
               one. -->
          <p class="hero__claim" data-placeholder></p>

          <p class="hero__pitch">Divadelní soubor, který se nebojí provokovat. Jsme tu abychom bourali hranice a vytvářeli nezapomenutelné zážitky!</p>

          <p><a class="button" href="/program/">Program</a></p>
        </div>
      </div>
    </article>

    <article class="hero__slide">
      <img
        class="hero__photo"
        src="/assets/panels/sipy-2.png"
        width="900"
        height="788"
        alt="Šest herců se sklání nad otevřeným komiksem, který drží uprostřed skupiny sedící na podlaze klubovny."
      />
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Repertoár</p>
          <p class="display hero__title">Co hrajeme</p>
          <p class="hero__pitch">Inscenace, které máme na repertoáru.</p>
          <p><a class="button" href="/repertoar/">Repertoár</a></p>
        </div>
      </div>
    </article>

    <article class="hero__slide">
      <img
        class="hero__photo"
        src="/assets/panels/ensemble.png"
        width="1100"
        height="913"
        alt="Skupina herců stojí těsně vedle sebe a dívá se do objektivu."
      />
      <div class="hero__copy">
        <div class="page__inner">
          <p class="hero__eyebrow">Soubor</p>
          <p class="display hero__title">Kdo jsme</p>
          <p class="hero__pitch">Lidé, kteří Kolekci Parchant tvoří.</p>
          <p><a class="button" href="/soubor/">Soubor</a></p>
        </div>
      </div>
    </article>

    <!-- Somewhere to press, and a place that says how many there are and
         which one this is. Outside the slides so it does not fade with
         them. -->
    <div class="hero__dots" role="group" aria-label="Sekce">
      <button class="hero__dot" type="button" aria-label="Program" aria-current="true"></button>
      <button class="hero__dot" type="button" aria-label="Repertoár"></button>
      <button class="hero__dot" type="button" aria-label="Soubor"></button>
    </div>
  </section>

  <section class="next page">
    <div class="page__inner">
      <!-- No upcoming dates is the normal launch state, said honestly. -->
      {drumDates.length === 0 ? (
        <Fragment>
          <div class="next__head"><h2 class="next__eyebrow">Nejbližší představení</h2></div>
          <div class="next__empty">
            <p>Zatím žádný vypsaný termín. Jakmile vypíšeme nové, najdete je tady.</p>
            <p><a class="link" href="https://www.instagram.com/kolekce_parchant">Sledovat na Instagramu</a></p>
          </div>
        </Fragment>
      ) : (
        <div class="drum" data-drum>
          <div class="next__head">
            <h2 class="next__eyebrow">Nejbližší představení</h2>
            <!-- Filled in by script, never by the build: this is a static
                 site, so a countdown rendered at build time is wrong from the
                 next midnight onward. Empty and hidden until the browser has
                 a clock, which is also why it carries no fallback text. -->
            <p class="drum__countdown" data-countdown hidden></p>
          </div>

          <div class="drum__window" data-drum-window>
            {drumDates.map((date, index) => (
              <div class="drum__slide" data-date={date.date} data-index={index}>
                <PerformanceDate entry={date} production={date.slug ? productionOf.get(date.slug) : undefined} />
              </div>
            ))}
          </div>

          <div class="drum__dots" role="group" aria-label="Termíny">
            {drumDates.map((date, index) => (
              <button
                class="drum__dot"
                type="button"
                aria-label={date.when}
                aria-current={index === 0 ? 'true' : undefined}
              ></button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="teaser page">
    <div class="page__inner">
      <h2 class="display page-heading">Repertoár</h2>
      <!-- Scrolls sideways rather than stacking: there are four titles now,
           not two, and a 2x2 grid of them pushes the rest of the page below
           the fold on a phone. -->
      <div class="deck-stage">
        <div class="deck" data-deck role="group" aria-roledescription="balíček karet" aria-label="Repertoár" tabindex="0">
          {productions.map((production) => (
            <article class="production-card deck__card">
              <!-- No identifiable photo exists for this production; an olive
                   block is honest, a misattributed photo is not. -->
              {production.data.photos.length > 0 ? (
                <img
                  src={production.data.photos[0].src}
                  width={production.data.photos[0].width}
                  height={production.data.photos[0].height}
                  alt={production.data.photos[0].alt}
                  loading="lazy"
                />
              ) : (
                <div class="production-card__blank" aria-hidden="true"></div>
              )}
              <h3 class="display production-card__title">
                <ProductionTitle titleLead={production.data.titleLead} titleRest={production.data.titleRest} />
              </h3>
              <p><a class="link" href={`/repertoar/${production.id}/`}>Více o inscenaci</a></p>
            </article>
          ))}

          {/* Title and nothing else. No page to link to and no copy to show, so
              the card says the one thing that is known and stops. */}
          {otherTitles.map((title) => (
            <article class="production-card deck__card">
              <div class="production-card__blank" data-placeholder aria-hidden="true"></div>
              <h3 class="display production-card__title">{title}</h3>
              <p class="production-card__note">Hrajeme. Stránka inscenace se připravuje.</p>
            </article>
          ))}
        </div>

        <!-- The deck is a drag, which is not an instruction anyone can see and
             not a gesture a keyboard has. These are how it is worked without
             one. -->
        <div class="deck__controls">
          <button class="deck__step" type="button" data-deck-prev>Zpět</button>
          <p class="deck__count" data-deck-count></p>
          <button class="deck__step" type="button" data-deck-next>Další</button>
        </div>

        <!-- Announced, not shown. The visible count is a few glyphs wide on
             purpose - printing the title there wrapped it to three lines
             between the two buttons and pushed them to the screen edges. The
             title still has to be said, because "3 / 4" on its own does not
             tell anyone what was just dealt. -->
        <p class="deck__live" data-deck-live aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The strip is its own dark band rather than a block on the wash, so it
     drops the page padding and paints edge to edge. */
  .hero {
    position: relative;
    padding: 0;
    background: transparent;
    /* One number for the height of the picture and for the room the slides
       reserve above their copy, so the two cannot drift apart. */
    --hero-photo: min(62vw, 24rem);
  }

  /* Only the first slide is in flow. The other two are laid over it, so the
     identity slide - the one with the most words in it - decides the height
     and the strip never resizes as it turns. */
  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: var(--hero-photo);
    visibility: hidden;
    opacity: 0;
    transition: opacity 900ms ease, visibility 0s linear 900ms;
  }

  /* Padding, not a margin on the copy: the slide has no border or padding of
     its own, so a top margin on its first child collapses straight through it
     and moves the slide instead of making room inside it - which left the
     photograph with nowhere to be and the wash showing where it should have
     been. */
  .hero__slide:first-child { position: relative; }

  .hero__slide[data-on] {
    visibility: visible;
    opacity: 1;
    transition: opacity 900ms ease, visibility 0s;
  }

  /* Cropped to the band it is actually seen in, not stretched over the whole
     slide. Covering the slide made the picture taller than the window above
     the copy, so the visible third was whatever happened to be at the top of
     the frame - ropes and ceiling rather than the people. */
  .hero__photo {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: var(--hero-photo);
    object-fit: cover;
    object-position: center;
  }

  /* A solid band, not a wash over the picture: the contrast harness reads a
     background-colour and looks straight through a gradient to whatever is
     behind it, and white over an unknown photograph is not a contrast anyone
     can promise. The photo fades into the band through ::before instead. */
  /* The band carries the page gutter itself, because .hero drops the padding
     .page would have given it in order to paint edge to edge. */
  .hero__copy {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 1.75rem var(--gutter) 2.25rem;
    background-color: var(--ink);
    color: var(--white);
  }

  .hero__copy::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 7rem;
    background: linear-gradient(to top, var(--ink), rgba(30, 27, 20, 0));
  }

  /* The copy arrives after the picture has settled, one line at a time, and
     leaves together - the same two beats as the menu. */
  .hero__copy > .page__inner > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 420ms ease, transform 420ms ease;
  }

  .hero__slide[data-on] .hero__copy > .page__inner > * { opacity: 1; transform: none; }

  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(1) { transition-delay: 260ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(2) { transition-delay: 340ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(3) { transition-delay: 420ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(4) { transition-delay: 500ms; }
  .hero__slide[data-on] .hero__copy > .page__inner > :nth-child(5) { transition-delay: 580ms; }

  .hero__dots {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1rem;
    display: flex;
    gap: 0.15rem;
  }

  /* The mark is small but the target is not: 44px of button around a 10px
     dot, which is what a thumb needs and what the dots must not look like. */
  .hero__dot {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-content: center;
  }

  .hero__dot::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 2px solid var(--white);
    background: transparent;
    transition: background-color 200ms ease;
  }

  .hero__dot[aria-current]::before { background: var(--white); }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.8rem;
    color: var(--white);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.4rem, 11vw, 5rem);
    line-height: 1;
    color: var(--white);
  }

  .hero__claim:empty { display: none; }

  .hero__pitch {
    max-width: var(--measure);
    margin: 1.25rem 0;
    font-size: clamp(1.05rem, 1rem + 0.6vw, 1.3rem);
    font-weight: 600;
    text-wrap: pretty;
  }

  .next__eyebrow {
    margin: 0 0 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .next__empty {
    max-width: var(--measure);
    padding: 1.5rem;
    border: 3px dashed var(--ink);
    border-radius: var(--radius-card);
  }

  .next__empty p { margin: 0 0 0.75rem; }
  .next__empty p:last-child { margin-bottom: 0; }

  .teaser { background: transparent; }

  /* A deck, not a row (2026-09-06). Four plays is a hand of cards, and a hand
     is a thing you deal through rather than scroll past - the top card gets
     the whole width instead of a quarter of it.

     The stage is what reserves the room. The deck itself is an aspect box and
     every card is absolutely positioned inside it, so the cards behind cannot
     add height; the fan leans them out past that box, which is what the
     stage's bottom padding is for. */
  .deck-stage { padding-bottom: 0.5rem; }

  .deck {
    position: relative;
    width: min(22rem, 82vw);
    margin-inline: auto;
    aspect-ratio: 3 / 4;
    /* Vertical drags belong to the page. Without this the deck eats the
       scroll on a phone and the section becomes a trap. */
    touch-action: pan-y;
  }

  .deck:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }

  .deck__card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    cursor: grab;
    /* Rotating about a point below the card swings it like a card held at its
       corner, rather than spinning it about its middle. */
    transform-origin: 50% 120%;
    box-shadow: 0 10px 24px rgba(30, 27, 20, 0.22);
    user-select: none;
  }

  .deck__card[data-dragging] { cursor: grabbing; }

  .deck__card img,
  .deck__card .production-card__blank { aspect-ratio: 6 / 5; object-fit: cover; }

  /* Pushed to the bottom of the card so every card's last line sits on the
     same baseline however long its title ran. */
  .deck__card > :last-child { margin-top: auto; margin-bottom: 0; }

  .deck__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    /* Clears the fan, which leans the cards behind below the deck's own box. */
    margin-top: 3.5rem;
  }

  .deck__step {
    min-height: 2.75rem;
    padding: 0.6rem 1.2rem;
    border: 0;
    border-radius: var(--radius-button);
    background: var(--button-bg);
    color: var(--button-text);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .deck__count { margin: 0; font-family: var(--display); font-size: 0.95rem; white-space: nowrap; }

  /* Present to a screen reader, absent to everything else. Not display:none,
     which would take it out of the accessibility tree and silence it. */
  .deck__live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .production-card__note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink);
  }

  /* "Rám inscenaci hra lásky a šípy - červenej rám" (2026-08-31, item 4).
     The inner picture frame stays ink, so the card reads as a red mount
     around a black-framed image rather than as two red rules. */
  .production-card { padding: 1.25rem; background: var(--paper); background-clip: padding-box; border: 3px solid var(--brick); border-radius: var(--radius-card); }

  .production-card img,
  .production-card__blank { display: block; width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-inner); }

  .production-card__blank { aspect-ratio: 900 / 750; background: var(--olive); }

  .production-card__title { margin: 1rem 0 0.5rem; font-size: clamp(1.5rem, 6vw, 2.2rem); }

  /* --- the hero falls into the page ---------------------------------------

     The hero ends in a solid ink band and the wash starts immediately under
     it; the gradient carries one into the other (2026-09-06: "mezi hero a
     strankou udelej gradient").

     The seam curves, and it is long enough that you stop reading it as an
     edge (2026-09-06: "klidne trochu vetsi curve, delsi prechod aby nebyl
     videt"). Concave: the centre clears first and the corners hold on, so the
     dark reads as a proscenium opening rather than as a block ending.

     Painted as flat ink behind a mask rather than as a gradient, because a
     gradient can only run in a straight line. The mask is two layers
     multiplied together:

       the radial one is the curve. On its own it leaves ~14% ink in the far
       corners, because those corners are a fixed distance from the ellipse's
       centre no matter how the stops are set - and the band has to END
       somewhere, so that residue would meet the wash on a hard line.

       the linear one is the guarantee. Multiplied in, it forces the whole
       width to zero before the band's edge, corners included.

     Tightening the ellipse is what deepens the bow, and the linear layer is
     what lets it be tightened at all.

     The top padding is not spacing, it is the safety margin that makes the
     seam legal: check.mjs decides what a line of text is printed on by
     walking up for a background-COLOR, and a mask on a pseudo-element is
     invisible to it. Text sitting in the dark half would be unreadable while
     the harness went on measuring it against the wash and passing. The band
     is 12rem and the padding clears 12rem. */
  .next {
    position: relative;
    padding-top: calc(var(--band-padding) + 12rem);
  }

  .next::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 12rem;
    pointer-events: none;
    background: var(--ink);
    -webkit-mask-image:
      radial-gradient(125% 100% at 50% 100%, rgba(0, 0, 0, 0) 30%, #000 100%),
      linear-gradient(to bottom, #000 45%, rgba(0, 0, 0, 0) 100%);
    mask-image:
      radial-gradient(125% 100% at 50% 100%, rgba(0, 0, 0, 0) 30%, #000 100%),
      linear-gradient(to bottom, #000 45%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* --- the drum ------------------------------------------------------------

     One date at a time, turning by itself, after the festival drum on
     radiobloodstream.com. The dates are a queue rather than a list: the next
     one is the answer to the question the section asks, and the ones behind
     it are there for anyone who wants to look further.

     Full content width, not the reading measure (2026-09-06: "nejblizsi
     predstaveni roztahni na sirku kontentu"): the ticket is a poster beside a
     few short lines, not a paragraph, so the measure was constraining
     something that is not prose. */
  .drum { max-width: none; }

  .next__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .next__head .next__eyebrow { margin: 0; }

  /* A stamp on the ticket, and the one place on the wash that carries the
     full cherry as a fill rather than as ink: white on it is 7.5:1, so the
     badge is readable wherever the drum happens to be. */
  .drum__countdown {
    margin: 0;
    padding: 0.3rem 0.7rem;
    background: var(--brick);
    color: var(--white);
    border-radius: var(--radius-button);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  /* Every slide is stacked in the same grid cell, so the tallest one sets the
     height and the window cannot resize as it turns - the same reason the
     hero keeps its first slide in flow. transform does not affect layout, so
     moving the slides sideways leaves that height alone.

     touch-action: pan-y hands vertical drags back to the page: the drum is
     halfway down a scrolling document and must never trap a scroll. */
  .drum__window {
    display: grid;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }

  .drum__window[data-dragging] { cursor: grabbing; }

  .drum__slide {
    grid-area: 1 / 1;
    min-width: 0;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* A drag must not leave a half-selected paragraph behind it. */
  .drum__window[data-dragging] .drum__slide { user-select: none; }

  .drum__dots {
    display: flex;
    justify-content: center;
    gap: 0.15rem;
    margin-top: 0.25rem;
  }

  /* 44px of button around a 10px dot - what a thumb needs, and what the dot
     must not look like. Same shape as the hero's, in the wash's ink rather
     than the band's white. */
  .drum__dot {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-content: center;
  }

  .drum__dot::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: transparent;
    transition: background-color 200ms ease;
  }

  .drum__dot[aria-current]::before { background: var(--accent); }
</style>

<script>
  // One slide per section, turning by itself. Paused while the tab is hidden:
  // a strip that has advanced six times behind someone's back is showing them
  // a section they never chose to look at.
  const reel = document.querySelector('[data-reel]');
  const slides = [...reel.querySelectorAll('.hero__slide')];
  const dots = [...reel.querySelectorAll('.hero__dot')];
  let index = 0;
  let timer;

  const show = (next) => {
    slides[index].removeAttribute('data-on');
    dots[index].removeAttribute('aria-current');
    index = (next + slides.length) % slides.length;
    slides[index].setAttribute('data-on', '');
    dots[index].setAttribute('aria-current', 'true');
  };

  const start = () => { timer = setInterval(() => show(index + 1), 6000); };
  const stop = () => { clearInterval(timer); };
  // Someone who has just chosen a slide should get a full turn to read it,
  // not the remainder of a tick that was already running.
  const restart = () => { stop(); start(); };

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { show(i); restart(); });
  });

  // Swipe. A drag that is mostly vertical is the page being scrolled, so the
  // strip stays out of it; both listeners are passive for the same reason.
  let startX = null;
  let startY = null;

  reel.addEventListener('touchstart', (event) => {
    const touch = event.changedTouches[0];
    startX = touch.clientX;
    startY = touch.clientY;
  }, { passive: true });

  reel.addEventListener('touchend', (event) => {
    if (startX === null) return;
    const touch = event.changedTouches[0];
    const dx = touch.clientX - startX;
    const dy = touch.clientY - startY;
    startX = null;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    show(index + (dx < 0 ? 1 : -1));
    restart();
  }, { passive: true });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else start();
  });

  start();
</script>

<script>
  // The drum: one performance date in the window, turning by itself, dragged
  // 1:1 by finger or mouse and snapping to the next on release. Ported from
  // the festival strip on radiobloodstream.com, which is React; this is the
  // same behaviour written against the DOM, because nothing else on this site
  // needs a framework and one strip is not a reason to start.
  const drum = document.querySelector('[data-drum]');

  if (drum) {
    const window_ = drum.querySelector('[data-drum-window]');
    const slides = [...drum.querySelectorAll('.drum__slide')];
    const dots = [...drum.querySelectorAll('.drum__dot')];
    const badge = drum.querySelector('[data-countdown]');
    const count = slides.length;

    const SWIPE_THRESHOLD = 40;
    const ROTATE_MS = 8000;

    let slot = 0;
    let previous = 0;
    let dragX = 0;
    let dragging = false;
    let startX = null;
    let startY = null;
    let dragged = false;
    let timer = null;
    let hovered = false;

    // How many days from today to an ISO date, in local calendar days: both
    // ends are floored to midnight, so the answer does not change with the
    // hour of the visit.
    const daysUntil = (iso) => {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const [year, month, day] = iso.split('-').map(Number);
      return Math.round((new Date(year, month - 1, day) - today) / 86400000);
    };

    // Czech counts three ways, and getting it wrong is the kind of thing that
    // makes a site read as machine-written: 1 den, 2-4 dny, 5+ dnů. One and
    // zero have words of their own instead.
    const countdownLabel = (iso) => {
      const days = daysUntil(iso);
      if (days < 0) return '';
      if (days === 0) return 'Dnes hrajeme';
      if (days === 1) return 'Zítra';
      if (days < 5) return `Za ${days} dny`;
      return `Za ${days} dnů`;
    };

    // Shortest way round the ring, so slide 0 approaches slide 5 from the
    // left rather than travelling back across the whole strip.
    const positionFor = (index, at) => {
      let position = index - at;
      if (position > count / 2) position -= count;
      if (position <= -count / 2) position += count;
      return position;
    };

    const layout = () => {
      slides.forEach((slide, index) => {
        const position = positionFor(index, slot);
        // A slide that has just wrapped from one end of the ring to the other
        // must jump, not fly across the window in front of the reader.
        const wrapped = Math.abs(position - positionFor(index, previous)) > 1;
        slide.style.transition = dragging || wrapped ? 'none' : '';
        slide.style.transform = `translateX(calc(${position * 100}% + ${dragX}px))`;
        // Only the slide in the window is offered to a screen reader or to
        // the tab key; the rest are off-screen and would otherwise scroll the
        // page sideways when focused.
        slide.inert = position !== 0;
        slide.setAttribute('aria-hidden', position === 0 ? 'false' : 'true');
      });

      dots.forEach((dot, index) => {
        if (index === slot) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });

      if (badge) {
        const label = countdownLabel(slides[slot].dataset.date);
        badge.textContent = label;
        badge.hidden = !label;
      }
    };

    const go = (next) => {
      previous = slot;
      slot = (next + count) % count;
      layout();
    };

    // Someone who has just chosen a date should get a full turn to read it,
    // not the remainder of a tick that was already running.
    const stop = () => { clearInterval(timer); timer = null; };
    const start = () => {
      stop();
      if (count < 2) return;
      // A strip that turns on its own is motion; anyone who has asked for
      // less of it gets the dots and the drag instead.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => {
        if (!dragging && !hovered) go(slot + 1);
      }, ROTATE_MS);
    };
    const restart = () => { stop(); start(); };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => { go(index); restart(); });
    });

    window_.addEventListener('pointerdown', (event) => {
      if (count < 2) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      dragging = true;
      dragged = false;
      startX = event.clientX;
      startY = event.clientY;
      window_.setAttribute('data-dragging', '');
    });

    window_.addEventListener('pointermove', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      // A drag that is mostly vertical is the page being scrolled. Let go of
      // it entirely rather than fighting the scroll for the gesture.
      if (!dragged && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
        startX = null;
        dragging = false;
        dragX = 0;
        window_.removeAttribute('data-dragging');
        layout();
        return;
      }
      if (!dragged && Math.abs(dx) > 5) {
        dragged = true;
        // Captured only once a real drag starts: capturing on pointerdown
        // retargets the eventual click to the window, which swallowed plain
        // taps on the ticket's own links.
        try { window_.setPointerCapture(event.pointerId); } catch { /* pointer already gone */ }
      }
      if (!dragged) return;
      dragX = dx;
      layout();
    });

    const release = (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      dragging = false;
      dragX = 0;
      window_.removeAttribute('data-dragging');
      if (Math.abs(dx) >= SWIPE_THRESHOLD) go(slot + (dx < 0 ? 1 : -1));
      else layout();
      restart();
    };

    window_.addEventListener('pointerup', release);
    window_.addEventListener('pointercancel', release);

    // A drag must not count as a click on the ticket's link.
    window_.addEventListener('click', (event) => {
      if (dragged) {
        event.preventDefault();
        event.stopPropagation();
        dragged = false;
      }
    }, true);

    window_.addEventListener('mouseenter', () => { hovered = true; });
    window_.addEventListener('mouseleave', () => { hovered = false; });

    // A drum that has turned six times behind someone's back is showing them
    // a date they never chose to look at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    layout();
    start();
  }
</script>

<script>
  // The repertoire deck. Drag the top card sideways and let go: past the
  // threshold it is thrown the way you pushed it and goes to the back, short
  // of it it springs back. Four plays, so it loops rather than running out.
  //
  // Only the top card is offered to a screen reader or the tab key. Three
  // stacked cards all announcing themselves under one another is noise, and a
  // link nobody can see is a trap - so the controls below are the accessible
  // way through, and /repertoar/ lists every production as plain text anyway.
  const deck = document.querySelector('[data-deck]');

  if (deck) {
    const cards = [...deck.querySelectorAll('.deck__card')];
    const stage = deck.closest('.deck-stage');
    const count = stage.querySelector('[data-deck-count]');
    const live = stage.querySelector('[data-deck-live]');
    const total = cards.length;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');

    const THROW = 70;

    // Which card is on top, then the one behind it, and so on. Everything the
    // deck knows is in this one array; every card's resting state is derived
    // from its position in it, so there is no per-card bookkeeping to drift.
    let order = cards.map((_, index) => index);
    let busy = false;
    let startX = null;
    let startY = null;
    let dragging = false;

    const titleOf = (card) => card.querySelector('.production-card__title')?.textContent.replace(/\s+/g, ' ').trim() ?? '';

    const settle = (animate = true) => {
      order.forEach((cardIndex, depth) => {
        const card = cards[cardIndex];
        const lift = depth * 10;
        const turn = depth === 0 ? 0 : (depth % 2 ? -1 : 1) * (2 + depth);
        card.style.transition = animate && !calm.matches
          ? 'transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease'
          : 'none';
        card.style.transform = `translateY(${lift}px) scale(${1 - depth * 0.04}) rotate(${turn}deg)`;
        card.style.zIndex = String(total - depth);
        // The fourth card down is behind two others and contributes nothing
        // but paint; hiding it keeps the stack from muddying at the edges.
        card.style.opacity = depth > 2 ? '0' : '1';
        card.inert = depth !== 0;
        card.setAttribute('aria-hidden', depth === 0 ? 'false' : 'true');
      });
      count.textContent = `${order[0] + 1} / ${total}`;
      live.textContent = `${order[0] + 1} z ${total}: ${titleOf(cards[order[0]])}`;
    };

    const advance = (direction) => {
      if (busy) return;
      const card = cards[order[0]];
      const rotate = () => {
        order = [...order.slice(1), order[0]];
        settle(false);
        // One frame at the back with no transition, then the whole deck eases
        // up a place - otherwise the card flies back from where it was thrown.
        requestAnimationFrame(() => settle(true));
      };
      if (calm.matches) {
        rotate();
        return;
      }
      busy = true;
      card.style.transition = 'transform 300ms ease-in, opacity 300ms ease-in';
      card.style.transform = `translateX(${direction * 130}%) rotate(${direction * 18}deg)`;
      card.style.opacity = '0';
      setTimeout(() => { rotate(); busy = false; }, 300);
    };

    // Backwards has nothing to throw - the card is arriving, not leaving - so
    // it simply takes its place at the front and the deck settles around it.
    const retreat = () => {
      if (busy) return;
      order = [order[order.length - 1], ...order.slice(0, -1)];
      settle(true);
    };

    deck.addEventListener('pointerdown', (event) => {
      if (busy) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (!cards[order[0]].contains(event.target)) return;
      startX = event.clientX;
      startY = event.clientY;
      dragging = false;
      cards[order[0]].setAttribute('data-dragging', '');
    });

    deck.addEventListener('pointermove', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      // A mostly-vertical drag is the page being scrolled; let go of it.
      if (!dragging && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
        startX = null;
        cards[order[0]].removeAttribute('data-dragging');
        settle(true);
        return;
      }
      if (!dragging && Math.abs(dx) > 4) {
        dragging = true;
        // Captured only once a real drag starts: capturing on pointerdown
        // retargets the eventual click and swallowed taps on the card's link.
        try { deck.setPointerCapture(event.pointerId); } catch { /* pointer already gone */ }
      }
      if (!dragging) return;
      const card = cards[order[0]];
      card.style.transition = 'none';
      card.style.transform = `translateX(${dx}px) rotate(${dx / 22}deg)`;
    });

    const drop = (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      cards[order[0]].removeAttribute('data-dragging');
      if (Math.abs(dx) >= THROW) advance(dx < 0 ? -1 : 1);
      else settle(true);
    };

    deck.addEventListener('pointerup', drop);
    deck.addEventListener('pointercancel', drop);

    // A drag must not count as a click on the card's link.
    deck.addEventListener('click', (event) => {
      if (dragging) {
        event.preventDefault();
        event.stopPropagation();
        dragging = false;
      }
    }, true);

    deck.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); advance(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); retreat(); }
    });

    stage.querySelector('[data-deck-next]').addEventListener('click', () => advance(-1));
    stage.querySelector('[data-deck-prev]').addEventListener('click', retreat);

    settle(false);
  }
</script>
