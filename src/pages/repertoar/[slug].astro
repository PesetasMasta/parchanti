---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductionTitle from '../../components/ProductionTitle.astro';
import program from '../../../data/program.json';
import { czechDate, czechDuration, upcoming } from '../../lib/program.js';

export async function getStaticPaths() {
  const productions = await getCollection('productions');
  return productions.map((production) => ({
    params: { slug: production.id },
    props: { production },
  }));
}

const { production } = Astro.props;
const data = production.data;

// Names come from the people collection; data holds only slugs, so a renamed
// person changes everywhere at once.
const people = await getCollection('people');
const nameOf = new Map(people.map((person) => [person.id, person.data.name]));

const title = `${[data.titleLead, data.titleRest].filter(Boolean).join(' ')} — Kolekce Parchant`;

// Running time and age are fields now, not free text inside creditsAfter, so
// the program page can render them too. They still read as credit rows here.
// When you can actually see it. The programme is the one place these live, so
// they are filtered out of it by slug rather than repeated on the production -
// a date cannot then be right on one page and stale on the other.
const playdates = upcoming(program.dates).filter((entry) => entry.slug === production.id);

const measurements = [
  data.durationMinutes && { label: 'Délka', text: czechDuration(data.durationMinutes) },
  data.ageRating && { label: 'Přístupnost', text: data.ageRating },
].filter(Boolean);
---
<Base title={title} description={data.blurb}>
  <article class="page">
    <div class="page__inner">
      <h1 class="display page-heading production__title">
        <ProductionTitle titleLead={data.titleLead} titleRest={data.titleRest} />
      </h1>

      <p class="production__blurb">{data.blurb}</p>

      <p class="prose production__annotation">{data.annotation}</p>

      <!-- High on the page on purpose: someone reading about a production is
           usually deciding whether they can go, and the answer to that should
           not be below the credits. -->
      <section class="playdates">
        <h2 class="playdates__heading">Kdy hrajeme</h2>
        {playdates.length === 0 ? (
          <p class="playdates__empty">
            Zatím nemáme vypsaný termín. Nové najdete v <a class="link" href="/program/">programu</a>.
          </p>
        ) : (
          <Fragment>
            <ul class="playdates__list">
              {playdates.map((entry) => (
                <li>
                  <a class="playdates__date" href={`/program/#termin-${entry.date}`}>
                    <span class="playdates__day display">{czechDate(entry.date)}</span>
                    <span class="playdates__time display">{entry.time}</span>
                    {entry.note && <span class="playdates__note">{entry.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
            <p><a class="link" href="/program/">Celý program</a></p>
          </Fragment>
        )}
      </section>

      <dl class="credits">
        {data.creditsBefore.map((row) => (
          <>
            <dt>{row.label}</dt>
            <dd>
              {row.parts.map((part, index) => (
                <>
                  {index > 0 && ', '}
                  {part.slug
                    ? <a class="link" href={`/soubor/${part.slug}/`}>{part.text}</a>
                    : part.text}
                </>
              ))}
            </dd>
          </>
        ))}

        <dt>Hrají</dt>
        <dd class="cast">
          {data.cast.map((group, groupIndex) => (
            <>
              {groupIndex > 0 && ', '}
              {group.map((slug, slugIndex) => (
                <>
                  {slugIndex > 0 && ' / '}
                  <a class="link" href={`/soubor/${slug}/`}>{nameOf.get(slug)}</a>
                </>
              ))}
            </>
          ))}
        </dd>

        {measurements.map((row) => (
          <>
            <dt>{row.label}</dt>
            <dd>{row.text}</dd>
          </>
        ))}

        {data.creditsAfter.map((row) => (
          <>
            <dt>{row.label}</dt>
            <dd>
              {row.parts.map((part, index) => (
                <>
                  {index > 0 && ', '}
                  {part.slug
                    ? <a class="link" href={`/soubor/${part.slug}/`}>{part.text}</a>
                    : part.text}
                </>
              ))}
            </dd>
          </>
        ))}
      </dl>

      <div class="press">
        <p class="press__score display">{data.score}</p>
        {data.quotes.map((quote) => (
          <blockquote>
            <p>{quote.text}</p>
            <footer>{quote.author} &middot; {quote.rating} &middot; {quote.date}</footer>
          </blockquote>
        ))}
        <p class="press__source">
          Hodnocení diváků na <a class="link" href={data.idivadlo}>i-divadlo.cz</a>
        </p>
      </div>

      {data.photos.length > 0 && (
        <div class="gallery">
          {data.photos.map((photo) => (
            <figure class="gallery__item">
              <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
    </div>
  </article>
</Base>

<style>
  .production__title { font-size: clamp(2.4rem, 11vw, 4.5rem); color: inherit; }

  .playdates { margin: 2rem 0; max-width: var(--measure); }

  .playdates__heading {
    margin: 0 0 0.75rem;
    font-family: var(--body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .playdates__list {
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Each date is a link into the programme, at the day it names. The pair is
     one object rather than a row of text: a date and a time belong together
     and wrap together. */
  .playdates__date {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    background: var(--paper);
    background-clip: padding-box;
    border: 3px solid var(--ink);
    border-radius: var(--radius-button);
    color: var(--ink);
    text-decoration: none;
  }

  .playdates__day { font-size: 1rem; }
  .playdates__time { font-size: 1rem; color: var(--accent); }

  .playdates__note {
    font-family: var(--body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .playdates__empty { margin: 0; }

  .production__blurb {
    max-width: var(--measure);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
    font-weight: 600;
  }

  .press {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--paper);
    background-clip: padding-box;
    border: 3px solid var(--ink);
    border-radius: var(--radius-card);
    max-width: var(--measure);
  }

  .press__score { margin: 0 0 1rem; font-size: clamp(2rem, 8vw, 3rem); color: var(--accent); }

  .press blockquote { margin: 0 0 1.25rem; padding-left: 1rem; border-left: 3px solid var(--accent); }

  .press blockquote p { margin: 0 0 0.5rem; font-style: italic; text-wrap: pretty; }

  .press blockquote footer {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .press__source { margin: 0; font-size: 0.82rem; }

  .gallery { display: grid; gap: 1rem; margin-top: 2.5rem; }

  @media (min-width: 48rem) { .gallery { grid-template-columns: 1fr 1fr; } }

  .gallery__item { margin: 0; }

  .gallery__item img { display: block; width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-inner); }
</style>
